		raise CliError("daemon did not return a job result")
	print("bgw: debug-job output is raw, unsanitised page data. Do not hand it to an agent.", file=sys.stderr)
	dump(result)
	return EXIT_OK if result.get("outcome") == "ok" else EXIT_TOOL_ERROR



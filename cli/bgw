def export_name(file_id: str, sniffed_type) -> str:
	"""The name an exported file gets: its id and an ending by what the daemon found it to be. Nothing else goes in.

	The id is checked again, so that what comes out is a plain name whatever was passed: no separator, no dot in front.
	"""
	if not isinstance(file_id, str) or not re.fullmatch(FILE_ID_RE, file_id):
		raise CliError("not a file id")
	return file_id + EXPORT_ENDINGS.get(sniffed_type if isinstance(sniffed_type, str) else "", EXPORT_ENDING_OTHER)


def label(name) -> str:
	"""The name a server gave a file, fit to be shown as a label on one line between markers. Never a path, never a file name."""
	text = name if isinstance(name, str) else ""
	kept = []
	for c in text[:1024]:
		if c.isalnum() or c in " ._()+,@~-":
			kept.append(c)
		elif not c.isspace():
			kept.append("_")
	return re.sub(r" +", " ", "".join(kept)).strip()[:MAX_LABEL]


def numbered(name: str, n: int) -> str:
	"""name for n == 1; "stem-n.ending" after that: the next name to try when one is taken."""
	if n <= 1:
		return name
	stem, dot, ending = name.rpartition(".")
	return "%s-%d.%s" % (stem, n, ending) if dot and stem and 0 < len(ending) <= 10 else "%s-%d" % (name, n)


def download_dir() -> str:
	"""The export directory: the one the environment names, or the gateway's own below the home directory."""
	named = overridden(DOWNLOAD_DIR_ENV)
	if named:
		paths = ntpath if WINDOWS else os.path
		if not paths.isabs(named):
			raise CliError("%s must be an absolute path" % DOWNLOAD_DIR_ENV)
		return paths.normpath(named)
	path = default_path(DOWNLOAD_DIR_ENV, DEFAULT_DOWNLOAD_DIR, "data", "exports")
	if WINDOWS:
		if store_python():
			raise CliError("no export directory: %s, or set %s to a directory outside %%LOCALAPPDATA%%" % (STORE_PYTHON_HINT, DOWNLOAD_DIR_ENV))
		# Below LOCALAPPDATA, which default_path found to be an absolute path.
		return path
	if not os.path.isabs(path):
		raise CliError("there is no home directory to keep exported files in: set %s to an absolute path" % DOWNLOAD_DIR_ENV)
	return os.path.normpath(path)


class NoRoom(CliError):
	"""The export directory holds as much as it may: the next file is not written."""


def open_download_dir(path: str, by_path=None):
	"""Open the export directory, making it (0700) if it is not there. Returns a descriptor of the directory, or
	on Windows its path (by_path: tests choose; else Windows only). Either is handed back to close_download_dir.

	The directory itself must be a real directory, owned by this user, that
	nobody else can write to: a symlink in its place is refused, not followed,
	and so is a directory that somebody else made first (they could delete or
	replace a file in it after its path was handed out). Everything that is
	written afterwards is written relative to the descriptor, so it lands in
	this directory whatever happens to the path meanwhile. The gateway's own
	directory is made with what leads to it; one the environment names must
	have its parent already. Part files that an export killed in the middle
	left behind, a day old or more, are removed here.

	Windows has no descriptors of directories: the directory is looked at by its path (a real directory, not a
	link or junction), and so is every name in it before it is used (see _at). Owner and mode are not looked
	at there: the ACL of the user profile keeps others out (docs/SECURITY-MODEL.md).
	"""
	by_path = WINDOWS if by_path is None else by_path
	problem = "cannot make the export directory %s: %s"
	if not os.environ.get(DOWNLOAD_DIR_ENV):
		try:
			os.makedirs(os.path.dirname(path), 0o700, exist_ok=True)
		except OSError as e:
			raise CliError(problem % (path, e.strerror or "error")) from None
	try:
		os.mkdir(path, 0o700)
	except FileExistsError:
		pass
	except OSError as e:
		raise CliError(problem % (path, e.strerror or "error")) from None
	if by_path:
		try:
			st = os.lstat(path)
		except OSError as e:
			raise CliError("the export directory %s cannot be used (%s): it must be a real directory, not a link" % (path, e.strerror or "error")) from None
		if st.st_mode & _S_IFMT != _S_IFDIR or _reparse(st):
			raise CliError("the export directory %s cannot be used (it is a link or not a directory): it must be a real directory, not a link" % path)
		sweep_leftovers(path)
		return path
	try:
		dir_fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
	except OSError as e:
		raise CliError("the export directory %s cannot be used (%s): it must be a real directory, not a link" % (path, e.strerror or "error")) from None
	try:
		st = os.fstat(dir_fd)
		if st.st_uid != os.geteuid():
			raise CliError("the export directory %s belongs to another user: not using it" % path)
		if st.st_mode & 0o022:
			raise CliError("the export directory %s can be written to by others (mode %04o): not using it; run chmod 700 on it" % (path, st.st_mode & 0o7777))
		sweep_leftovers(dir_fd)
	except BaseException:
		os.close(dir_fd)
		raise
	return dir_fd


def close_download_dir(where):
	"""Let go of what open_download_dir returned."""
	if isinstance(where, int):
		os.close(where)


def _at(where, name: str) -> tuple:
	"""A name in the export directory, as the os calls take it: (name, descriptor of the directory) where there is
	one, else (the full path, None). where is what open_download_dir returned."""
	if isinstance(where, str):
		return os.path.join(where, name), None
	return name, where


def _own(st) -> bool:
	"""Is the file this user's? Windows has no owner here to compare (the profile's ACL stands in): yes."""
	return WINDOWS or st.st_uid == os.geteuid()


def sweep_leftovers(where):
	"""Remove what a killed export left in the directory: part files and temporary files of this tool, old, ours.

	Only names this tool makes (a fixed prefix and random hex), only plain files of this user, only when
	EXPORT_LEFTOVER_AGE_S old: the part file of an export that is under way now is younger. Never an error.
	"""
	try:
		names = os.listdir(where)
	except OSError:
		return
	cutoff = time.time() - EXPORT_LEFTOVER_AGE_S
	for name in names:
		if not re.fullmatch(r"\.bgw-(part-[0-9a-f]{16}|export-[0-9a-f]{12}\.tmp)", name):
			continue
		at, dir_fd = _at(where, name)
		try:
			st = os.stat(at, dir_fd=dir_fd, follow_symlinks=False)
			if _plain(st) and _own(st) and st.st_mtime < cutoff:
				os.unlink(at, dir_fd=dir_fd)
		except OSError:
			pass


def directory_bytes(where) -> int:
	"""What the plain files in the directory add up to. Links are not followed and not counted."""
	total = 0
	for name in os.listdir(where):
		if WINDOWS and name.startswith(".bgw-part-"):
			# A part file there may be a second name of a finished export that could not be removed (held): its
			# bytes are counted under the other name. The part file of an export under way holds nothing yet.
			continue
		at, dir_fd = _at(where, name)
		try:
			st = os.stat(at, dir_fd=dir_fd, follow_symlinks=False)
		except OSError:
			continue
		if _plain(st):
			total += st.st_size
	return total


def has_content(where, name: str, size: int, sha256: str) -> bool:
	"""Is there a plain file of this user called name in the directory with exactly this size and SHA-256?

	The bytes on disk are hashed; the name says nothing. A link or anything but a plain file is not it.
	"""
	at, dir_fd = _at(where, name)
	seen = None
	try:
		if dir_fd is None:
			# No O_NOFOLLOW on Windows: looked at first, and what is opened must be what was looked at.
			seen = os.lstat(at)
			if not _plain(seen):
				return False
			fd = os.open(at, os.O_RDONLY | _O_BINARY | _O_NOFOLLOW | _O_NONBLOCK)
		else:
			fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
	except OSError:
		return False
	try:
		st = os.fstat(fd)
		if not _plain(st) or not _own(st) or st.st_size != size:
			return False
		if seen is not None and (st.st_dev, st.st_ino) != (seen.st_dev, seen.st_ino):
			return False
		digest = hashlib.sha256()
		seen_bytes = 0
		while True:
			piece = os.read(fd, 1048576)
			if not piece:
				break
			digest.update(piece)
			seen_bytes += len(piece)
		return seen_bytes == size and hmac.compare_digest(digest.hexdigest(), sha256)
	except OSError:
		return False
	finally:
		os.close(fd)


class _Already(Exception):
	"""The directory holds this very file already, under this name."""

	def __init__(self, name):
		super().__init__(name)
		self.name = name


def save_download(where, fetch, name_of, limit: int = EXPORT_DIR_MAX_BYTES) -> tuple:
	"""Write one file into the export directory, as open_download_dir returned it.

	fetch(write, begin) delivers the bytes, calls begin(what is known of the file)
	before the first of them, and returns that; name_of(that) says what to call
	it. The bytes go to a hidden new file first (0600, exclusive, no link
	followed) and get their name only when all of them are there. A name that is
	taken by other content is never replaced: "name-2", "name-3" and so on are
	tried. A name that is taken by this very content (same size, same SHA-256 on
	disk) is the answer: nothing is fetched or written again. The directory may
	hold `limit` bytes in all; a file that would pass that is refused (NoRoom)
	before any of it is written. Returns (the name it got, what fetch returned).
	"""
	part = ".bgw-part-%s" % secrets.token_hex(8)
	part_at, dir_fd = _at(where, part)
	fd = os.open(part_at, os.O_WRONLY | os.O_CREAT | os.O_EXCL | _O_NOFOLLOW | _O_BINARY, 0o600, dir_fd=dir_fd)
	known = {}

	def begin(info):
		known["info"] = info
		name = name_of(info)
		for n in range(1, 1000):
			final = numbered(name, n)
			try:
				os.stat(_at(where, final)[0], dir_fd=dir_fd, follow_symlinks=False)
			except FileNotFoundError:
				break
			except OSError:
				continue
			if has_content(where, final, info["size"], info["sha256"]):
				raise _Already(final)
		used = directory_bytes(where)
		if used + info["size"] > limit:
			raise NoRoom("it holds %d MiB and this file is %d MiB, the limit is %d MiB; delete files in it that are no longer needed, then try again" % (used // 1048576, -(-info["size"] // 1048576), limit // 1048576))

	try:
		try:
			with os.fdopen(fd, "wb") as f:
				info = fetch(f.write, begin)
				f.flush()
				os.fsync(f.fileno())
		except _Already as same_file:
			return same_file.name, known["info"]
		name = name_of(info)
		for n in range(1, 1000):
			final = numbered(name, n)
			try:
				# A second name for the finished file: fails where that name is taken (a link there too), follows no link.
				if dir_fd is None:
					os.link(part_at, _at(where, final)[0])
				else:
					os.link(part, final, src_dir_fd=dir_fd, dst_dir_fd=dir_fd, follow_symlinks=False)
			except FileExistsError:
				continue
			except OSError as e:
				if WINDOWS:
					raise NoLink(_at(where, final)[0], e) from None
				raise
			if WINDOWS and dir_fd is None:
				mark_downloaded(_at(where, final)[0])
			return final, info
		raise CliError("no free name for the file in the export directory")
	finally:
		try:
			remove_file(part_at, dir_fd=dir_fd)
		except OSError:
			pass


def is_request_id(value) -> bool:
	"""A JSON-RPC id as the daemon takes it: a string, or an integer that JavaScript holds exactly."""
	return isinstance(value, str) or (isinstance(value, int) and not isinstance(value, bool) and abs(value) <= 9007199254740991)


def mcp_name_header(name: str):
	"""The Mcp-Name header for a tool name: plain where it can be, else in the Base64 form. None: it cannot be sent."""
	if re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", name):
		return name
	try:
		encoded = base64.b64encode(name.encode("utf-8")).decode("ascii")
	except UnicodeError:
		return None
	return "=?base64?%s?=" % encoded if len(encoded) <= 2048 else None


class McpCall:
	"""One request of the client that is on its way to the daemon."""

	def __init__(self, message, line):
		self.message = message
		self.line = line
		self.key = json.dumps(message["id"])
		self.lock = threading.Lock()
		self.daemon = None
		self.cancelled = False
		self.thread = None
		# Set when, for this call, the listener proved that it holds the token. Never before, never for another call.
		self.proved = False

	def cancel(self):
		"""The client no longer wants the answer: none is sent, and the request to the daemon is given up."""
		with self.lock:
			self.cancelled = True
			daemon = self.daemon
		if daemon is not None:
			daemon.abort()


class PipeInput:
	"""How "bgw mcp" waits for stdin on POSIX: select() on stdin and on a pipe of its own, which a signal
	(signal.set_wakeup_fd) or wake() writes to. Only the main thread may make one, as for signal handlers."""

	def __init__(self, fd: int):
		self.fd = fd
		self.wake_r, self.wake_w = os.pipe()
		os.set_blocking(self.wake_w, False)
		os.set_blocking(self.wake_r, False)
		self.previous = signal.set_wakeup_fd(self.wake_w)

	def wake(self):
		try:
			os.write(self.wake_w, b"x")
		except OSError:
			pass

	def next(self):
		"""What stdin gave: bytes, b"" at its end, None when nothing came within a second or on a wake-up."""
		readable, _, _ = select.select([self.fd, self.wake_r], [], [], 1.0)
		if self.wake_r in readable:
			try:
				os.read(self.wake_r, 64)
			except OSError:
				pass
			return None
		if self.fd not in readable:
			return None
		try:
			return os.read(self.fd, 65536)
		except BlockingIOError:
			return None
		except OSError:
			return b""

	def close(self):
		signal.set_wakeup_fd(self.previous)
		os.close(self.wake_r)
		os.close(self.wake_w)


class ThreadInput:
	"""How "bgw mcp" waits for stdin on Windows, where select() takes sockets only and a signal wakes no pipe:
	a thread reads stdin, blocking, and hands each piece over through a queue. The queue is short, so a client
	that sends faster than its requests are taken in waits on its pipe, as it would on POSIX."""

	def __init__(self, fd: int):
		self.fd = fd
		self.pieces = queue.Queue(16)
		threading.Thread(target=self._read, name="bgw-mcp-in", daemon=True).start()

	def _read(self):
		while True:
			try:
				piece = os.read(self.fd, 65536)
			except OSError:
				piece = b""
			self.pieces.put(piece)
			if piece == b"":
				return

	def wake(self):
		try:
			self.pieces.put_nowait(None)
		except queue.Full:
			# Something is there to be taken already: the loop looks at stop then.
			pass

	def next(self):
		"""As PipeInput.next. A signal is seen within the second the wait lasts (its handler only sets stop)."""
		try:
			return self.pieces.get(timeout=1.0)
		except queue.Empty:
			return None

	def close(self):
		# The thread may be left in its read: it holds nothing, and ends with the process.
		pass


class McpServer:
	"""bgw mcp: the gateway's MCP tools for a client that talks over stdin and stdout.

	Every request is passed to the daemon on a connection of its own, after the
	daemon proved on that connection that it holds the agent token. When that
	cannot be done - nothing listens, the listener proves nothing, no token file,
	no answer in time - the handshake and the tool list are answered from here
	and a tool call gets an error result that says what is wrong. The next
	request tries again.
	"""

	def __init__(self, stdin_fd=0, stdout_fd=1, threaded=None):
		# Settled once, before any token is read: where requests go.
		self.port = daemon_port()
		self.stdin_fd = stdin_fd
		self.stdout_fd = stdout_fd
		# How stdin is waited for and stdout written to: ThreadInput and blocking writes on Windows, else PipeInput and
		# select(). Tests choose the Windows way on Linux with threaded=True.
		self.threaded = WINDOWS if threaded is None else threaded
		self.state_lock = threading.Lock()
		self.calls = []
		# What is to be written to stdout, in order: one thread writes, so that nothing else ever waits on a client
		# that is slow to read - not the loop that reads stdin, and not a signal that asks to stop.
		self.outbox = queue.Queue(MCP_MAX_UNWRITTEN)
		# Answers that are in the outbox and not written yet.
		self.unsent = 0
		self.input = None
		self.tools = None
		self.negotiated = None
		self.last_state = None
		self.closing = False
		self.stop = False
		self.identity = {"name": "browser-gateway", "version": cli_version() or "0.0.0", "title": "Browser Gateway"}

	# ------------------------------------------------------------ output

	def _send(self, message, call=None):
		"""Hand one protocol message to the writer: one line. Nothing else is ever written to stdout.

		With "call", the request that this answers gives up its place in the same step.
		"""
		data = None if message is None else json.dumps(message, separators=(",", ":")).encode("ascii") + b"\n"
		with self.state_lock:
			if call is not None and call in self.calls:
				self.calls.remove(call)
			if data is None or self.closing:
				return
			self.unsent += 1
		try:
			self.outbox.put_nowait(data)
		except queue.Full:
			with self.state_lock:
				self.unsent -= 1
			self._client_gone()

	def _client_gone(self):
		"""The client does not read, or its end of stdout is closed: nothing more can be said to it."""
		with self.state_lock:
			self.closing = True
		self.stop = True
		waiting = self.input
		if waiting is not None:
			waiting.wake()

	def _write_loop(self):
		"""The one thread that writes to stdout."""
		while True:
			data = self.outbox.get()
			if data is None:
				return
			try:
				view = memoryview(data)
				while len(view) > 0:
					try:
						written = os.write(self.stdout_fd, view)
					except BlockingIOError:
						# A stdout that does not block (POSIX): wait until it takes more. On Windows writes block, and
						# select() would not take a pipe: this is not reached there but for an odd handle, which gets a pause.
						if self.threaded:
							time.sleep(0.05)
						else:
							select.select([], [self.stdout_fd], [], 1.0)
						continue
					view = view[written:]
			except OSError:
				self._client_gone()
			finally:
				with self.state_lock:
					self.unsent -= 1

	def _note(self, state, text):
		"""A line on stderr whenever what stands between here and the daemon changes. Never a token."""
		with self.state_lock:
			if state == self.last_state:
				return
			self.last_state = state
		try:
			print("bgw mcp: %s" % text, file=sys.stderr, flush=True)
		except OSError:
			pass

	def _say(self, text):
		"""A line on stderr about something that happens once (a start on demand, a wait). Never a token."""
		try:
			print("bgw mcp: %s" % text, file=sys.stderr, flush=True)
		except OSError:
			pass

	# ------------------------------------------------------------ answers made here

	def _modern(self, message):
		"""Does the request use the style without a handshake? (What the daemon tells by its headers.)"""
		method = message.get("method")
		if method == "initialize":
			return False
		params = message.get("params")
		meta = params.get("_meta") if isinstance(params, dict) else None
		return method == "server/discover" or (isinstance(meta, dict) and MCP_META_VERSION in meta)

	def _result(self, message, result, extra=None):
		if self._modern(message):
			result = dict(result, resultType="complete", **(extra or {}))
			result["_meta"] = {MCP_META_SERVER: dict(self.identity)}
		return {"jsonrpc": "2.0", "id": message["id"], "result": result}

	def _error(self, request_id, code, text):
		return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": text}}

	def _tool_error(self, message, text):
		return self._result(message, {"content": [{"type": "text", "text": text}], "isError": True})

	def _local(self, message, problem):
		"""The answer to a request the daemon could not be asked for. problem: one sentence that says why."""
		method = message["method"]
		params = message.get("params")
		listing = {"ttlMs": MCP_TOOLS_TTL_MS, "cacheScope": "public"}
		if method == "initialize":
			asked = params.get("protocolVersion") if isinstance(params, dict) else None
			if not isinstance(asked, str) or asked == "":
				return self._error(message["id"], RPC_INVALID_PARAMS, "initialize needs params.protocolVersion as a string")
			version = asked if asked in MCP_LEGACY_VERSIONS else MCP_LEGACY_VERSIONS[0]
			self.negotiated = version
			return self._result(message, {"protocolVersion": version, "capabilities": {"tools": {}}, "serverInfo": dict(self.identity), "instructions": MCP_INSTRUCTIONS})
		if method == "tools/list":
			return self._result(message, {"tools": self.tools if self.tools is not None else with_helper_tools(builtin_tools())}, listing)
		if method == "server/discover":
			return self._result(message, {"supportedVersions": list(MCP_MODERN_VERSIONS + MCP_LEGACY_VERSIONS), "capabilities": {"tools": {}}, "instructions": MCP_INSTRUCTIONS}, listing)
		if method == "ping" and not self._modern(message):
			return self._result(message, {})
		if method == "tools/call":
			return self._tool_error(message, "Browser Gateway: %s. Nothing was fetched. Tell the user; do not retry in a loop." % problem)
		return self._error(message["id"], RPC_INTERNAL_ERROR, "Browser Gateway: %s" % problem)

	# ------------------------------------------------------------ the way to the daemon

	def _headers(self, message):
		"""The HTTP headers the daemon expects with this message. None: it cannot be put into headers."""
		method = message["method"]
		params = message.get("params")
		meta = params.get("_meta") if isinstance(params, dict) else None
		version = meta.get(MCP_META_VERSION) if isinstance(meta, dict) else None
		headers = {}
		if method == "initialize":
			return headers
		if isinstance(version, str) or method == "server/discover":
			# The style without a handshake repeats in headers what the body says.
			if not re.fullmatch(r"[A-Za-z0-9_./-]{1,128}", method):
				return None
			headers["Mcp-Method"] = method
			if isinstance(version, str):
				if not re.fullmatch(r"[0-9A-Za-z._-]{1,32}", version):
					return None
				headers["MCP-Protocol-Version"] = version
			if method == "tools/call" and isinstance(params, dict) and isinstance(params.get("name"), str):
				name = mcp_name_header(params["name"])
				if name is None:
					return None
				headers["Mcp-Name"] = name
		elif self.negotiated is not None:
			headers["MCP-Protocol-Version"] = self.negotiated
		return headers

	def _problem(self, error):
		"""One sentence for a failure to reach the daemon, and the name of the state it stands for."""
		where = "127.0.0.1:%d" % self.port
		if error.kind == "down":
			# The handshake and the tool list start nothing; a tool call does, where the operator switched that on.
			return "down", "the gateway daemon is not running on %s (%s)" % (where, "it is started on demand by the next tool call" if on_demand() else "start it with: bgw daemon start")
		if error.kind == "start":
			return "start", str(error)
		if error.kind == "not_daemon":
			return "not_daemon", "the process on %s is not the gateway daemon - no token and no request was sent to it" % where
		if error.kind == "token":
			return "token", "%s - nothing was sent" % error
		if error.kind == "timeout":
			return "timeout", "the gateway daemon on %s did not answer in time" % where
		return "other", "the gateway daemon on %s could not be asked (%s)" % (where, error)

	def _reach(self, call, daemon) -> bool:
		"""Open the connection for a call. A tool call starts the daemon first where nothing listens and starting on
		demand is on; the handshake and the tool list never do. Returns whether the daemon came up during this call."""
		if call.message["method"] != "tools/call" or not on_demand():
			daemon.connect()
			return False
		return connect_or_start(daemon, self._say)

	def _needs_browser(self, message) -> bool:
		"""Is this a call of a tool that sends a job to the browser? The others read the store, or are answered by the daemon itself."""
		params = message.get("params")
		return message["method"] == "tools/call" and isinstance(params, dict) and params.get("name") in ("browser_fetch", "browser_search")

	def _forward(self, call):
		"""Ask the daemon. Returns the JSON-RPC answer to pass on. Raises CliError when there is none."""
		message = call.message
		method = message["method"]
		headers = self._headers(message)
		if headers is None:
			return self._error(message["id"], RPC_INVALID_REQUEST, "Invalid request: the method, the protocol version or the tool name cannot be passed on")
		quick = method != "tools/call"
		handshake = method in ("initialize", "tools/list", "server/discover", "ping")
		timeout = MCP_HANDSHAKE_TIMEOUT_S if handshake else QUICK_TIMEOUT_S if quick else JOB_TIMEOUT_S
		with call.lock:
			if call.cancelled:
				raise CliError("the request was cancelled", kind="cancelled")
			# A connection of its own: what one connection proved says nothing about the next.
			daemon = call.daemon = Daemon()
		try:
			# In this order: is anything there, is there a token to ask it about, does it hold that token.
			came_up = self._reach(call, daemon)
			token = read_token("client")
			daemon.prove("client", token, min(timeout, QUICK_TIMEOUT_S))
			call.proved = True
			if came_up and self._needs_browser(message):
				wait_for_extension(daemon, "client", self._say, lambda: call.cancelled)
			status, payload = daemon._exchange("POST", MCP_PATH, None, token, timeout, MAX_ANSWER_BYTES, headers, call.line)
		finally:
			daemon.close()
		if isinstance(payload, dict) and payload.get("jsonrpc") == "2.0" and (("result" in payload) != ("error" in payload)) and payload.get("id") in (message["id"], None):
			payload["id"] = message["id"]
			return payload
		if status == 401:
			raise CliError("it rejected the token (401): is the token file the one of this daemon?")
		if status == 413:
			return self._error(message["id"], RPC_INVALID_REQUEST, "Invalid request: larger than the gateway daemon takes")
		raise CliError("it answered HTTP %d without an MCP answer" % status)

	def _file_export(self, call):
		"""tools/call file_export: fetch the bytes of a retrieved file from the daemon and write them into the
		export directory, under a name made here. Answered here; the daemon is only asked for the bytes, on a connection that proved itself."""
		message = call.message
		arguments = message["params"].get("arguments")
		if not isinstance(arguments, dict) or set(arguments) != {"file"} or not isinstance(arguments["file"], str) or not re.fullmatch(FILE_ID_RE, arguments["file"]):
			return self._tool_error(message, '[browser-gateway] outcome=error code=invalid_argument\naction: file_export takes one argument, "file": the file id (fl_...) of a browser_fetch result.')
		file_id = arguments["file"]
		try:
			directory = download_dir()
		except CliError as e:
			return self._tool_error(message, "[browser-gateway] outcome=error code=download_dir_unusable\naction: %s. Nothing was written. Tell the user." % clean(str(e)))
		with call.lock:
			if call.cancelled:
				raise CliError("the request was cancelled", kind="cancelled")
			daemon = call.daemon = Daemon()
		dir_fd = None
		try:
			# In this order: is anything there, is there a token to ask it about, does it hold that token. Only then the directory.
			self._reach(call, daemon)
			daemon.prove("client", read_token("client"))
			call.proved = True
			try:
				dir_fd = open_download_dir(directory)
			except CliError as e:
				return self._tool_error(message, "[browser-gateway] outcome=error code=download_dir_unusable\naction: %s. Nothing was written. Tell the user." % clean(str(e)))
			# The name is made here, of the id and of what the daemon found the file to be. What a server called it is a label, below.
			final, info = save_download(dir_fd, lambda write, begin: download_file(daemon, file_id, write, begin), lambda known: export_name(file_id, known["type"]))
		except Refused as e:
			return self._tool_error(message, "[browser-gateway] outcome=error code=export_refused\naction: The gateway did not hand out that file: %s" % e)
		except NoRoom as e:
			return self._tool_error(message, "[browser-gateway] outcome=error code=export_dir_full\naction: The export directory %s is full: %s. Nothing was written. Tell the user." % (clean(directory), clean(str(e))))
		except NoLink as e:
			return self._tool_error(message, "[browser-gateway] outcome=error code=write_failed\naction: %s. Nothing was written. Tell the user." % clean(str(e)))
		except OSError as e:
			return self._tool_error(message, "[browser-gateway] outcome=error code=write_failed\naction: The file could not be written into the export directory (%s). Tell the user." % clean(e.strerror or e.__class__.__name__))
		finally:
			daemon.close()
			if dir_fd is not None:
				close_download_dir(dir_fd)
		lines = [
			"[browser-gateway] outcome=ok kind=file_export file=%s" % file_id,
			"file: type=%s size=%d sha256=%s" % (info["type"], info["size"], info["sha256"]),
			# Made of the directory this helper was given and of a name made here: nothing of it is a server's.
			"path: %s" % clean(os.path.join(directory, final)),
			"%s - written as it was retrieved; nothing opened, unpacked or rendered it." % ("access: that of the export directory (Windows)" if WINDOWS else "mode: 0600"),
			FILE_WARNING,
		]
		shown = label(info["name"])
		if shown != "":
			nonce = secrets.token_hex(4)
			while nonce in shown:
				nonce = secrets.token_hex(4)
			lines += [_NOTICE, "<<<BEGIN_UNTRUSTED_WEB_CONTENT %s>>>" % nonce, "name: %s" % shown, "<<<END_UNTRUSTED_WEB_CONTENT %s>>>" % nonce]
		return self._result(message, {"content": [{"type": "text", "text": "\n".join(lines)}], "isError": False})

	def _own_tool(self, message):
		"""Is this a call of a tool that this helper answers itself?"""
		params = message.get("params")
		return message["method"] == "tools/call" and isinstance(params, dict) and params.get("name") == FILE_EXPORT_TOOL

	def _answer(self, call):
		message = call.message
		try:
			reply = self._file_export(call) if self._own_tool(message) else self._forward(call)
		except CliError as e:
			if e.kind == "cancelled":
				return None
			state, problem = self._problem(e)
			self._note(state, problem)
			return self._local(message, problem)
		# Said of what happened in this call, and of nothing else: an answer that was made without asking the
		# daemon (bad arguments, a message that cannot be passed on) says nothing about who listens on the port.
		if call.proved:
			self._note("ok", "connected to the gateway daemon on 127.0.0.1:%d (it proved that it holds the token)" % self.port)
		result = reply.get("result")
		if isinstance(result, dict):
			if message["method"] == "tools/list" and isinstance(result.get("tools"), list):
				# The daemon's tools, and behind them the one that is answered here.
				result["tools"] = with_helper_tools(result["tools"])
				self.tools = result["tools"]
			if message["method"] == "initialize" and result.get("protocolVersion") in MCP_LEGACY_VERSIONS:
				self.negotiated = result["protocolVersion"]
		return reply

	def _work(self, call):
		try:
			try:
				reply = self._answer(call)
			except Exception as e:  # a bug here must not leave the client waiting for ever
				reply = self._error(call.message["id"], RPC_INTERNAL_ERROR, "Internal error in bgw mcp (%s)" % e.__class__.__name__)
		except BaseException:
			self._send(None, call)
			raise
		with call.lock:
			cancelled = call.cancelled
		# Its place is free the moment its answer is handed over: a client that asks again at once is not told "busy".
		self._send(None if cancelled else reply, call)

	# ------------------------------------------------------------ input

	def _handle_line(self, line):
		if line.strip() == b"":
			return
		try:
			message = json.loads(line.decode("utf-8"))
		except (ValueError, RecursionError):
			return self._send(self._error(None, RPC_PARSE_ERROR, "Parse error"))
		if isinstance(message, list):
			return self._send(self._error(None, RPC_INVALID_REQUEST, "Batch requests are not supported"))
		if not isinstance(message, dict):
			return self._send(self._error(None, RPC_INVALID_REQUEST, "Invalid request"))
		readable = message.get("id") if is_request_id(message.get("id")) else None
		if message.get("jsonrpc") != "2.0":
			return self._send(self._error(readable, RPC_INVALID_REQUEST, 'Invalid request: jsonrpc must be "2.0"'))
		if "method" not in message:
			# An answer to something that was never asked: nothing to do with it.
			return
		method = message["method"]
		if not isinstance(method, str) or method == "":
			return self._send(self._error(readable, RPC_INVALID_REQUEST, "Invalid request: method must be a string"))
		if "id" not in message:
			# A notification gets no reply. The daemon keeps no state they could change; one of them matters here.
			if method == "notifications/cancelled":
				params = message.get("params")
				asked = params.get("requestId") if isinstance(params, dict) else None
				if is_request_id(asked):
					key = json.dumps(asked)
					with self.state_lock:
						found = [c for c in self.calls if c.key == key]
					for call in found:
						call.cancel()
			return
		if readable is None:
			return self._send(self._error(None, RPC_INVALID_REQUEST, "Invalid request: id must be a string or an integer"))
		call = McpCall(message, line)
		with self.state_lock:
			busy = len(self.calls) >= MCP_MAX_INFLIGHT
			if not busy:
				self.calls.append(call)
		if busy:
			problem = "too many calls are still running (%d)" % MCP_MAX_INFLIGHT
			return self._send(self._tool_error(message, "Browser Gateway: %s. Try again when one has ended." % problem) if method == "tools/call" else self._error(readable, RPC_SERVER_ERROR, "Browser Gateway: %s" % problem))
		call.thread = threading.Thread(target=self._work, args=(call,), name="bgw-mcp-call", daemon=True)
		call.thread.start()

	def run(self) -> int:
		"""Serve until stdin ends or a signal asks to stop. Returns the exit code."""
		if WINDOWS:
			# Bytes as they are: a text mode stdin or stdout would turn line ends around and end at a Ctrl-Z.
			for fd in (self.stdin_fd, self.stdout_fd):
				try:
					msvcrt.setmode(fd, os.O_BINARY)
				except OSError:
					pass
		writer = threading.Thread(target=self._write_loop, name="bgw-mcp-out", daemon=True)

		def on_signal(_number, _frame):
			self.stop = True

		waiting = self.input = ThreadInput(self.stdin_fd) if self.threaded else PipeInput(self.stdin_fd)
		writer.start()
		for number in (signal.SIGTERM, signal.SIGINT):
			signal.signal(number, on_signal)
		pending = bytearray()
		skipping = False
		drain = 0.0
		try:
			while not self.stop:
				chunk = waiting.next()
				if chunk is None:
					continue
				if chunk == b"":
					# The client closed stdin: calls that are nearly done may still answer.
					drain = MCP_EOF_DRAIN_S
					if not skipping and 0 < len(pending) <= MCP_MAX_LINE_BYTES:
						# A last message without a line end is one all the same.
						self._handle_line(bytes(pending))
					break
				pending += chunk
				while True:
					end = pending.find(b"\n")
					if end == -1:
						if len(pending) > MCP_MAX_LINE_BYTES:
							# A line without end is not kept: said once, then skipped to where it ends.
							if not skipping:
								self._send(self._error(None, RPC_INVALID_REQUEST, "Invalid request: a message is larger than %d bytes" % MCP_MAX_LINE_BYTES))
							skipping = True
							del pending[:]
						break
					line = bytes(pending[:end])
					del pending[: end + 1]
					if skipping:
						skipping = False
					elif len(line) > MCP_MAX_LINE_BYTES:
						self._send(self._error(None, RPC_INVALID_REQUEST, "Invalid request: a message is larger than %d bytes" % MCP_MAX_LINE_BYTES))
					else:
						self._handle_line(line[:-1] if line.endswith(b"\r") else line)
		finally:
			self._shutdown(drain)
			try:
				self.outbox.put_nowait(None)
			except queue.Full:
				pass
			# A writer that is stuck on a client that does not read is left behind: it holds nothing but its thread.
			writer.join(0.5)
			self.input = None
			waiting.close()
		return EXIT_OK

	def _shutdown(self, drain):
		"""End every call that is still on its way: no thread of this process is left waiting on the daemon."""
		deadline = time.monotonic() + drain
		while time.monotonic() < deadline and not self.stop:
			# Until every answer that is due has been written, not merely made.
			with self.state_lock:
				if not self.calls and self.unsent == 0:
					break
			time.sleep(0.02)
		with self.state_lock:
			self.closing = True
			left = list(self.calls)
		for call in left:
			call.cancel()
		deadline = time.monotonic() + 2.0
		for call in left:
			if call.thread is not None:
				call.thread.join(max(0.0, deadline - time.monotonic()))


def cmd_mcp(args) -> int:
	return McpServer().run()


# What cmd.exe makes something of outside quotes: an argument with any of these (or a space or a tab) is quoted.
CMD_SPECIAL = '&^%!()|<>";'


def windows_command_line(argv: list) -> str:
	"""argv as one command line for cmd.exe, quoted the way the Microsoft C runtime takes a command line apart (for
	what needs no quotes for cmd.exe, the rules of the standard library's list2cmdline, which a test compares): quotes
	around an empty argument and around one with a space, a tab or a character cmd.exe acts on (CMD_SPECIAL), a quote
	in an argument escaped, the backslashes in front of it and at the end doubled. cmd.exe still expands %NAME%
	between quotes: cmd_mcp_config says so where an argument holds a %."""
	parts = []
	for arg in argv:
		text = re.sub(r'(\\*)"', lambda m: m.group(1) * 2 + '\\"', arg)
		if arg == "" or " " in arg or "\t" in arg or any(c in arg for c in CMD_SPECIAL):
			text = '"' + re.sub(r"(\\*)\Z", lambda m: m.group(1) * 2, text) + '"'
		parts.append(text)
	return " ".join(parts)


def mcp_registration(script: str) -> tuple:
	"""How "bgw mcp" is registered in Claude Code: (the claude mcp add command line, the entry of ~/.claude.json).

	Windows: this Python (sys.executable: "py -3" is the launcher, not a Python), and BGW_ON_DEMAND=1 in the
	entry, so that the first tool call starts the daemon (Windows has no service that holds the port for it).
	"""
	if WINDOWS:
		python = sys.executable or "python"
		argv = ["claude", "mcp", "add", "--scope", "user", "-e", "%s=1" % ON_DEMAND_ENV, "browser-gateway", "--", python, script, "mcp"]
		return windows_command_line(argv), {"type": "stdio", "command": python, "args": [script, "mcp"], "env": {ON_DEMAND_ENV: "1"}}
	argv = ["claude", "mcp", "add", "--scope", "user", "browser-gateway", "--", "python3", script, "mcp"]
	return " ".join(shlex.quote(a) for a in argv), {"type": "stdio", "command": "python3", "args": [script, "mcp"]}


def cmd_mcp_config(args) -> int:
	"""Say how to register "bgw mcp" in Claude Code. Prints only: no configuration is read or changed."""
	command, entry = mcp_registration(script_path())
	if args.json:
		dump({"name": "browser-gateway", "command": command, "config": entry})
		return EXIT_OK
	print("Register the gateway in Claude Code (user scope), in a %s:" % ("command prompt" if WINDOWS else "shell"))
	print()
	print("  " + command)
	print()
	if WINDOWS and store_python():
		print("Warning: %s." % STORE_PYTHON_HINT)
		print()
	if WINDOWS and "%" in command:
		print("Note: a path above holds a %, which cmd.exe expands even between quotes: use the JSON entry below instead.")
		print()
	print('Or add this entry by hand under "mcpServers" in ~/.claude.json, named "browser-gateway"%s:' % (" (~ is your user profile folder)" if WINDOWS else ""))
	print()
	print("  " + json.dumps(entry))
	print()
	print("This starts \"bgw mcp\": the gateway's tools over stdin/stdout. It sends the agent token only")
	print("to a daemon that proved, on that connection, that it holds it. Nothing was changed by this command.")
	return EXIT_OK


def cmd_daemon(args) -> int:
	"""Start, stop or look up a daemon that runs from this checkout. The work is done by a module of its
	own next to this script (daemon_controller)."""
	# Settled here, as for every command: only http://127.0.0.1:<port>.
	return daemon_controller().run(args.action, daemon_port(), script_path(), json_output=args.json)


# The commands that start the daemon when nothing listens on the port and starting on demand is on. Those that
# send a job to the browser name the token they ask the daemon's status with while the extension connects;
# the others read the store or talk to the daemon alone. status, doctor and debug-job only look: they start nothing.
STARTS_DAEMON = {cmd_fetch: "client", cmd_search: "client", cmd_open: "admin", cmd_read: None, cmd_pages: None, cmd_export: None, cmd_pair: None, cmd_pending: None}


def build_parser():
	parser = Parser(prog="bgw", description="Client for the Browser Gateway daemon.", epilog="Exit codes: 0 ok, 2 the gateway reported an error, 1 no usable answer (not running, not the daemon, no token, bad usage).")
	sub = parser.add_subparsers(dest="command", metavar="command", parser_class=Parser)
	formats = ["markdown", "text", "links", "html", "raw_html"]

	p = sub.add_parser("fetch", help="fetch a page through the operator's browser and print it")
	p.add_argument("url", help="http(s) URL")
	p.add_argument("--format", choices=formats, default="markdown", help="markdown: the main content, or the full page where that left most of it out; text: everything the page shows; raw_html: the page source (large: read it by offset, or use bgw export)")
	p.add_argument("--max-chars", type=int, default=None, metavar="N", help="characters to return, 100..60000 (default 20000)")
	p.add_argument("--fresh", action="store_true", help="skip the cache")
	p.add_argument("--session", choices=["auto", "isolated"], default="auto", help="isolated never uses the operator's logged-in session")
	p.add_argument("--wait-for-human", type=int, default=None, metavar="S", help="when the page shows a human check: wait up to S seconds (0..120) for the operator to pass it, instead of answering at once")
	p.add_argument("--json", action="store_true", help="print the JSON answer instead of its text")
	p.set_defaults(func=cmd_fetch)

	p = sub.add_parser("search", help="search the web through the operator's browser and print the results")
	p.add_argument("query", help="what to search for")
	p.add_argument("--engine", default=None, metavar="NAME", help="search engine (default: the daemon's; bgw status --admin lists them)")
	p.add_argument("--limit", type=int, default=None, metavar="N", help="maximum results, 1..20 (default 10)")
	p.add_argument("--json", action="store_true", help="print the JSON answer instead of its text")
	p.set_defaults(func=cmd_search)

	p = sub.add_parser("read", help="continue reading a stored page")
	p.add_argument("page", help="page id from a fetch result (pg_...)")
	p.add_argument("--offset", type=int, default=None, metavar="N", help="character offset to continue from")
	p.add_argument("--max-chars", type=int, default=None, metavar="N", help="characters to return, 100..60000 (default 20000)")
	p.add_argument("--format", choices=formats, default="markdown")
	p.add_argument("--json", action="store_true", help="print the JSON answer instead of its text")
	p.set_defaults(func=cmd_read)

	p = sub.add_parser("pages", help="full-text search over the stored pages")
	p.add_argument("query", help="words to find")
	p.add_argument("--limit", type=int, default=None, metavar="N", help="maximum hits, 1..50 (default 10)")
	p.add_argument("--json", action="store_true", help="print the JSON answer instead of its text")
	p.set_defaults(func=cmd_pages)

	p = sub.add_parser("export", help="write the stored content of a page (needs admin.token), or the bytes of a retrieved file, exactly as stored, to a file (never printed)")
	p.add_argument("page", metavar="id", help="page id (pg_...) or file id (fl_...) from a fetch result")
	p.add_argument("--format", choices=["markdown", "text", "html", "raw_html"], default=None, help="which stored form of a page; needed for a page, not allowed for a file")
	p.add_argument("-o", "--output", default=None, metavar="FILE", help="file to create (mode 0600); an existing file is not overwritten. Needed for a page. Without it a file (fl_...) goes into the export directory (BGW_DOWNLOAD_DIR, default ~/.local/share/browser-gateway/exports, on Windows %%LOCALAPPDATA%%\\browser-gateway\\data\\exports) as <id> and an ending by its kind")
	p.add_argument("--force", action="store_true", help="replace FILE if it exists (with -o only)")
	p.add_argument("--json", action="store_true", help="print the result as JSON")
	p.set_defaults(func=cmd_export, parser=p)

	p = sub.add_parser("status", help="show daemon, pairing and extension state")
	p.add_argument("--admin", action="store_true", help="the operator's view: browser and extension versions, pause reason, opt-in hosts (needs admin.token)")
	p.add_argument("--json", action="store_true", help="print the raw JSON answer")
	p.set_defaults(func=cmd_status)

	p = sub.add_parser("doctor", help="check daemon, proof, pairing and extension; exit 0 only when a fetch can work")
	p.add_argument("--json", action="store_true", help="print the checks as JSON")
	p.set_defaults(func=cmd_doctor)

	p = sub.add_parser("pair", help="print a one-time pairing code for the browser extension (needs admin.token)")
	p.add_argument("--json", action="store_true", help="print the code as JSON")
	p.set_defaults(func=cmd_pair)

	p = sub.add_parser("pending", help="list the pages with a human check that wait for you (needs admin.token)")
	p.add_argument("--json", action="store_true", help="print the list as JSON")
	p.set_defaults(func=cmd_pending)

	p = sub.add_parser("open", help="bring the page of a pending human check up in a browser window of its own (needs admin.token)")
	p.add_argument("job", help="job id from bgw pending (j_...)")
	p.add_argument("--json", action="store_true", help="print the answer as JSON")
	p.set_defaults(func=cmd_open)

	p = sub.add_parser("debug-job", help="submit a raw job and print its raw result as JSON (needs admin.token; unsanitised page data)")
	p.add_argument("url", help="http(s) URL to load")
	p.add_argument("--kind", choices=["fetch", "probe"], default="fetch")
	p.add_argument("--session", choices=["auto", "isolated"], default="auto")
	p.add_argument("--timeout-ms", type=int, default=None, metavar="MS", help="page load timeout, 1000..300000; the daemon cuts it to 120000")
	p.add_argument("--html", action="store_true", help="also ask for the page HTML")
	p.set_defaults(func=cmd_debug_job)

	p = sub.add_parser("mcp", help="MCP server on stdin/stdout: the gateway's tools for an agent's client, with the proof step before every request")
	p.set_defaults(func=cmd_mcp, standalone=True)

	p = sub.add_parser("mcp-config", help="print how to register \"bgw mcp\" in Claude Code; changes nothing")
	p.add_argument("--json", action="store_true", help="print the command and the config entry as JSON")
	p.set_defaults(func=cmd_mcp_config, standalone=True)

	p = sub.add_parser("daemon", help="start, stop or look up a daemon that runs from this checkout as a plain host process (operator)")
	p.add_argument("action", choices=["start", "stop", "status"])
	p.add_argument("--json", action="store_true", help="print the result as JSON")
	p.set_defaults(func=cmd_daemon, standalone=True)
	return parser


def main(argv):
	parser = build_parser()
	args = parser.parse_args(argv)
	if not hasattr(args, "func"):
		parser.print_usage(sys.stderr)
		return EXIT_FAILED
	if args.func is cmd_export:
		# A page is stored in several forms and one must be named; a file is its bytes and nothing else.
		is_file = re.fullmatch(FILE_ID_RE, args.page) is not None
		if not is_file and args.format is None:
			args.parser.error("the following arguments are required for a page: --format")
		if not is_file and args.output is None:
			args.parser.error("the following arguments are required for a page: -o/--output")
		if is_file and args.format is not None:
			args.parser.error("argument --format: not allowed for a file (fl_...), which is exported as it is")
	daemon = None
	try:
		if getattr(args, "standalone", False):
			# Commands that make their own connections, or none.
			return args.func(args)
		# Settle where to connect before a token is even read.
		daemon = Daemon()
		if args.func in STARTS_DAEMON and on_demand():
			say = lambda text: print("bgw: %s" % text, file=sys.stderr, flush=True)
			came_up = connect_or_start(daemon, say)
			if came_up and STARTS_DAEMON[args.func] is not None:
				wait_for_extension(daemon, STARTS_DAEMON[args.func], say)
		return args.func(args, daemon)
	except CliError as e:
		# A command that only looks says who would start the daemon.
		hint = " - " + ON_DEMAND_HINT if e.kind == "down" and getattr(args, "func", None) not in STARTS_DAEMON and on_demand() else ""
		print("bgw: %s%s" % (e, hint), file=sys.stderr)
		return e.code
	except BrokenPipeError:
		return EXIT_FAILED
	except KeyboardInterrupt:
		print("bgw: interrupted", file=sys.stderr)
		return EXIT_FAILED
	except Exception as e:
		# Last resort, after the proof: an answer of a shape nobody expected. One line and the name of the
		# error, never a traceback - its frames would show values that came from the peer.
		print("bgw: unexpected answer from the daemon (%s)" % e.__class__.__name__, file=sys.stderr)
		return EXIT_FAILED
	finally:
		if daemon is not None:
			daemon.close()


if __name__ == "__main__":
	sys.exit(main(sys.argv[1:]))

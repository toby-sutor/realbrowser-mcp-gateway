ON_DEMAND_ENV = "BGW_ON_DEMAND"
ON_DEMAND_HINT = "it is started on demand by the next command that needs it (fetch, search, read, pages, export, pair, pending, open)"
# After a start on demand: how long the browser extension gets to connect before a job is sent anyway, and how
# often the daemon is asked. The extension redials a daemon that was down with pauses that grow to 30 s
# (extension/background/link.js, capMs; a test compares), so the wait has to be longer than that.
EXTENSION_WAIT_S = 45
EXTENSION_POLL_S = 1.0

# A token file is a line of at most 128 characters; anything larger than this is not one, and is not read further.
TOKEN_FILE_MAX_BYTES = 512
# st_mode: the file type bits, a plain file, a directory, a link (the stat module is not needed for a few numbers).
_S_IFMT = 0o170000
_S_IFREG = 0o100000
_S_IFDIR = 0o040000
_S_IFLNK = 0o120000
# st_file_attributes (Windows only): a reparse point. st_reparse_tag: one that names another place (a name surrogate:
# a link, a junction) - as Node takes it. Others (OneDrive placeholders, deduplicated files) are files like any.
_FILE_ATTRIBUTE_REPARSE_POINT = 0x400
_IO_REPARSE_TAG_NAME_SURROGATE = 0x20000000
# Windows: the Mark of the Web, written next to an exported file (its Zone.Identifier stream): from the Internet zone.
ZONE_IDENTIFIER = b"[ZoneTransfer]\r\nZoneId=3\r\n"
# Windows: a file that was just written may be held for a moment (a scanner): its removal is tried this often.
UNLINK_TRIES = 5
UNLINK_RETRY_S = 0.05
# Open flags that one of the two systems lacks: 0 there. O_BINARY keeps Windows from changing line ends.
_O_BINARY = getattr(os, "O_BINARY", 0)
_O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
_O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)

EXIT_OK = 0
EXIT_FAILED = 1
EXIT_TOOL_ERROR = 2

# How long an answer may take, from the first byte of the request to the last
# byte of the answer - not merely the longest pause between two bytes.
QUICK_TIMEOUT_S = 10.0
# The daemon's own bounds, in seconds (daemon/src/config.js LIMITS.maxQueueMs
# and LIMITS.maxRunMs, daemon/src/fetchsvc.js FETCH_LIMITS.maxWaitForHumanS; a
# test compares them): the longest a job waits in the queue, the longest it
# holds the browser whatever the page-load limit is set to, and the longest a
# caller is held while its page waits for the operator.
DAEMON_QUEUE_S = 120
DAEMON_RUN_S = 240
DAEMON_HOLD_S = 120
# Longest a fetch or search can take on the daemon's side, plus slack.
JOB_TIMEOUT_S = float(DAEMON_QUEUE_S + DAEMON_RUN_S + DAEMON_HOLD_S + 15)
# How large an answer may be. Whatever sits on the port could send without end,
# and nothing it sends is worth anything before it proved to be the daemon.
MAX_ANSWER_BYTES = 1048576
# A raw job result is a frame of up to 8 MiB from the extension, as JSON.
MAX_JOB_ANSWER_BYTES = 16777216
# An export answer: up to 8 Mi characters, each of which may be a six byte escape in JSON.
MAX_EXPORT_ANSWER_BYTES = 50331648
# One piece of a retrieved file as the daemon hands it out (daemon/src/files.js FILE_LIMITS.exportChunkBytes; a
# test compares): that many bytes as base64, and a little JSON around them.
FILE_EXPORT_CHUNK_BYTES = 3145728
MAX_FILE_PIECE_ANSWER_BYTES = FILE_EXPORT_CHUNK_BYTES * 4 // 3 + 65536
# The largest file the gateway carries at all (the protocol's MAX_FILE_BYTES).
MAX_FILE_BYTES = 209715200
FILE_ID_RE = r"fl_[0-9A-HJKMNP-TV-Z]{26}"
# What the sniffer of the daemon can call a file: a media type in plain characters.
FILE_TYPE_RE = r"[a-z0-9.+-]{1,60}/[a-z0-9.+-]{1,60}"
# The ending of an exported file, by what the daemon's sniffer found the file to be and by nothing else
# (daemon/src/files.js EXPORT_ENDINGS; a test compares). A file is written as "<file id><ending>": no name or path
# a server gave has a part in it, and every kind of text is ".txt" - never .html, .svg, .py or .md - except text

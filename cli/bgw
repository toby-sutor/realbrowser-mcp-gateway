def cmd_doctor(args, daemon):
	"""Walk the chain from here to the browser and stop at the first break."""
	report = {
		"address": "127.0.0.1:%d" % daemon.port,
		"reachable": False,
		"proof": False,
		"paired": None,
		"extension_connected": None,
		"paused": None,
		"audit_ok": None,
		"versions": {"cli": cli_version(), "daemon": None, "extension": None, "browser": None},
		"on_demand": on_demand(),
		"problem": None,
	}
	code = EXIT_FAILED
	try:
		health = daemon.open_call("/healthz")
		if health.get("name") != "browser-gateway":
			raise CliError("127.0.0.1:%d answers, but not like the gateway daemon" % daemon.port)
		report["reachable"] = True
		status, _ = daemon.call("client", "GET", "/v1/status")
		# Only now is anything the peer says worth repeating.
		report["proof"] = True
		version = status.get("version")
		report["versions"]["daemon"] = clean(version) if isinstance(version, str) else None
		for key in ("paired", "extension_connected", "paused", "audit_ok"):
			report[key] = status.get(key) if isinstance(status.get(key), bool) else None
		if status.get("notifications") == "unavailable":
			# A daemon on Windows: no desktop notifications there. Absent elsewhere, and then not in the report either.
			report["notifications"] = "unavailable"
		if report["paired"] is not True:
			report["problem"] = "the extension is not paired: run bgw pair and paste the code into its options page"
		elif report["extension_connected"] is not True:
			report["problem"] = "the browser extension is not connected: is the browser running, and the extension enabled?"
		elif report["paused"] is True:
			report["problem"] = "the operator paused the gateway (toolbar button of the extension)"
		elif report["audit_ok"] is not True:
			report["problem"] = "the daemon cannot write its audit log and refuses work until it can (free disk space?)"
		code = EXIT_OK if report["problem"] is None else EXIT_TOOL_ERROR
	except CliError as e:
		# doctor only looks: it starts nothing, and says who would.
		report["problem"] = "%s - %s" % (e, ON_DEMAND_HINT) if e.kind == "down" and report["on_demand"] else str(e)

	# Versions of the extension and the browser are for the operator. Where the
	# admin token can be read, say them; where not, that is no failure.
	if report["proof"] and os.access(token_path("admin"), os.R_OK):
		try:
			detail, _ = daemon.call("admin", "GET", "/v1/status")
			ext = detail.get("extension")
			if isinstance(ext, dict) and ext.get("connected"):
				browser = as_object(ext.get("browser"))
				report["versions"]["extension"] = clean(ext.get("ext_version", "?"))
				report["versions"]["browser"] = clean("%s %s" % (browser.get("name", "?"), browser.get("version", "?"))).strip()
			# Paired, not connected, and an extension of another protocol version keeps coming: that is the break.
			if report["paired"] is True and report["extension_connected"] is False and version_mismatch(ext):
				report["problem"] = version_mismatch(ext)
		except CliError:
			pass

	if args.json:
		dump(report)
		return code
	v = report["versions"]
	print("reachable: %s" % ("yes, %s" % report["address"] if report["reachable"] else "NO"))
	print("proof:     %s" % ("ok, the daemon holds the agent token" if report["proof"] else "NO" if report["reachable"] else "-"))
	if report["proof"]:
		print("paired:    %s" % yes(report["paired"], "NO"))
		print("extension: %s" % ("connected" if report["extension_connected"] is True else "NOT connected"))
		print("paused:    %s" % ("YES" if report["paused"] is True else "no"))
		print("audit:     %s" % ("ok" if report["audit_ok"] is True else "FAILED"))
		if report.get("notifications") == "unavailable":
			print("notifications: not available on Windows")
	parts = []
	for name in ("cli", "daemon", "extension", "browser"):
		if v[name]:
			parts.append("%s %s" % (name, v[name]))
	print("versions:  %s" % (", ".join(parts) if parts else "-"))
	print("result:    %s" % ("ready" if code == EXIT_OK else clean(report["problem"])))
	return code


# ---------------------------------------------------------------- starting the daemon


def script_path() -> str:
	"""The real absolute path of this script."""
	return os.path.realpath(__file__)


def daemon_controller():
	"""The module next to this script that starts and stops a daemon of this checkout.

	Nothing in this file, which reads tokens, ever starts a program: that is done there, in a module that holds
	no way to a token. It is loaded for the "daemon" command and for a start on demand, and for nothing else.
	"""
	here = os.path.dirname(script_path())
	path = os.path.join(here, "bgw_daemonctl.py")
	# No bytecode cache next to the script: the checkout may be read-only.
	sys.dont_write_bytecode = True
	spec = importlib.util.spec_from_file_location("bgw_daemonctl", path)
	if spec is None or spec.loader is None or not os.path.isfile(path):
		raise CliError("bgw daemon needs %s, which is not there" % path)
	module = importlib.util.module_from_spec(spec)
	spec.loader.exec_module(module)
	return module


# One start at a time in this process ("bgw mcp" answers several calls at once). Between processes the
# controller keeps the order itself.
_START_LOCK = threading.Lock()


def connect_or_start(daemon, say) -> bool:
	"""Open the connection to the daemon; where nothing listens on the port, start the daemon first.

	Called only where starting on demand is on. Only a refused connection leads to a start: whatever does listen
	on the port is left to the proof step, which sends it nothing unless it holds the token. The daemon is started
	as "bgw daemon start" starts it, from the checkout this script sits in; say() gets one line about it.

	Returns True when the daemon came up during this call: started here, or by another client that found it down
	at the same moment. Raises CliError when it could not be started.
	"""
	try:
		daemon.connect()
		return False
	except CliError as e:
		if e.kind != "down":
			raise
	where = "127.0.0.1:%d" % daemon.port
	with _START_LOCK:
		result = daemon_controller().start_on_demand(daemon.port, script_path())
	if not isinstance(result, dict) or result.get("ok") is not True:
		reason = result.get("error") if isinstance(result, dict) else None
		raise CliError("the daemon is not running on %s and could not be started on demand: %s" % (where, clean(reason if isinstance(reason, str) else "no reason given")), kind="start")
	note = clean(result.get("note"))
	if result.get("started") is True:
		pid, log = result.get("pid"), result.get("log")
		say("the daemon was not running on %s - started it on demand%s" % (where, " (pid %d, log %s)" % (pid, clean(log)) if isinstance(pid, int) and isinstance(log, str) else ""))
	try:
		daemon.connect()
	except CliError as e:
		if e.kind != "down":
			raise
		raise CliError("the daemon does not answer on %s after a start on demand (%s)" % (where, note), kind="start") from None
	return True


def wait_for_extension(daemon, role, say, cancelled=None):
	"""After the daemon came up during this call: give the browser extension time to find it before a job is sent.

	A job that is sent at once would mostly be answered "extension not connected": the extension redials a daemon
	that was down with growing pauses. The daemon's status is asked about once a second - with the token, so the
	proof comes first, as for any request. Returns when the extension is connected, when the time is up, or when
	the daemon is not paired (then no extension can connect at all). The job is sent in each of these cases, and
	the daemon answers it its own way. Never called for a daemon that was running already.
	"""
	deadline = time.monotonic() + EXTENSION_WAIT_S
	said = False
	while True:
		status, _ = daemon.call(role, "GET", "/v1/status")
		if status.get("extension_connected") is True or status.get("paired") is not True:
			return
		if time.monotonic() >= deadline:
			return
		if not said:
			say("waiting up to %d s for the browser extension to connect to the daemon" % EXTENSION_WAIT_S)
			said = True
		pause = time.monotonic() + EXTENSION_POLL_S
		while time.monotonic() < pause:
			if cancelled is not None and cancelled():
				raise CliError("the request was cancelled", kind="cancelled")
			time.sleep(0.05)



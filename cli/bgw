# Windows has no select() for pipes, no wake-up pipe for signals, no descriptors of directories: what differs
# there is chosen by this, here and nowhere else (tests set it to try the Windows ways on Linux).
WINDOWS = os.name == "nt"
if WINDOWS:
	import msvcrt

DEFAULT_URL = "http://127.0.0.1:8791"
# The literal path on purpose: sandboxes remap XDG_CONFIG_HOME, the daemon does not. On Windows: default_path().
DEFAULT_TOKEN_FILE = "~/.config/browser-gateway/client.token"
DEFAULT_ADMIN_TOKEN_FILE = "~/.config/browser-gateway/admin.token"
DEFAULT_CONFIG_DIR = "~/.config/browser-gateway"
# The operator's switch for starting the daemon on demand: a file of this name in the config directory.

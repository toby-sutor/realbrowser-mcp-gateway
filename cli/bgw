def write_new_file(path, data, force):
	"""Write data to a file created with mode 0600. An existing file is left alone unless force is set.

	Without force the file is created exclusively, so nothing is overwritten and
	no symlink is followed. With force the data goes to a new file next to it that
	then takes its place: a symlink at that path is replaced, not written through.
	"""
	flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | _O_NOFOLLOW | _O_BINARY
	if not force:
		try:
			fd = os.open(path, flags, 0o600)
		except FileExistsError:
			raise CliError("%s exists; use --force to overwrite it" % path) from None
		except OSError as e:
			raise CliError("cannot write %s: %s" % (path, e.strerror or "error")) from None
		target = path
	else:
		directory = os.path.dirname(os.path.abspath(path))
		target = os.path.join(directory, ".bgw-export-%s.tmp" % secrets.token_hex(6))
		try:
			if os.path.isdir(path):
				raise CliError("%s is a directory" % path)
			fd = os.open(target, flags, 0o600)
		except OSError as e:
			raise CliError("cannot write %s: %s" % (path, e.strerror or "error")) from None
	try:
		with os.fdopen(fd, "wb") as f:
			f.write(data)
		if force:
			os.replace(target, path)
	except OSError as e:
		try:
			os.unlink(target)
		except OSError:
			pass
		raise CliError("cannot write %s: %s" % (path, e.strerror or "error")) from None


class Refused(Exception):
	"""The gateway answered, and the answer is no: its own words for why."""


def download_file(daemon, file_id, write, begin=None):
	"""The bytes of a retrieved file, piece by piece, each handed to write(bytes).

	begin(info), if given, is called once with what the daemon says the file is, before the first piece is
	written; whatever it raises ends the download there (and nothing more is fetched).
	Returns what the daemon says the file is: {"name", "type", "size", "sha256"}.
	What arrives is held to that: every piece where it belongs, the size in the
	end, and the SHA-256 over all of it. Raises Refused when the gateway says no,
	CliError for everything else - and then whatever write() was given is not a file.
	"""
	offset = 0
	digest = hashlib.sha256()
	info = None
	bad = CliError("daemon did not return the bytes of that file")
	while True:
		answer, _ = daemon.call("client", "POST", "/v1/files/export", {"file": file_id, "offset": offset}, QUICK_TIMEOUT_S, MAX_FILE_PIECE_ANSWER_BYTES, refusals=(400, 404, 500))
		if answer.get("ok") is False:
			detail = answer.get("detail")
			raise Refused(clean(detail if isinstance(detail, str) else answer.get("error"), True).replace("\n", " | "))
		size = answer.get("size")
		told = {"name": answer.get("name"), "type": answer.get("type"), "size": size, "sha256": answer.get("sha256")}
		if answer.get("file") != file_id or answer.get("encoding") != "base64" or answer.get("offset") != offset or not isinstance(answer.get("data"), str):
			raise bad
		if not isinstance(size, int) or isinstance(size, bool) or not 0 <= size <= MAX_FILE_BYTES:
			raise bad
		if not isinstance(told["name"], str) or not isinstance(told["type"], str) or not re.fullmatch(FILE_TYPE_RE, told["type"]):
			raise bad
		if not isinstance(told["sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", told["sha256"]):
			raise bad
		if info is None:
			info = told
			if begin is not None:
				begin(info)
		elif told != info:
			raise CliError("the file changed while it was being read")
		try:
			piece = base64.b64decode(answer["data"], validate=True)
		except ValueError:
			raise bad from None
		if len(piece) != answer.get("length") or len(piece) > FILE_EXPORT_CHUNK_BYTES or offset + len(piece) > size:
			raise bad
		write(piece)
		digest.update(piece)
		offset += len(piece)
		if answer.get("eof") is True:
			break
		if len(piece) == 0:
			raise bad
	if offset != info["size"] or not hmac.compare_digest(digest.hexdigest(), info["sha256"]):
		raise CliError("the file did not arrive whole (size or SHA-256 do not match what the daemon stored)")
	return info


class NoLink(CliError):
	"""Windows: the directory's file system makes no hard links (FAT, exFAT, many shares), which a new file needs to
	get its name without replacing one that is there."""

	def __init__(self, path, error):
		super().__init__("cannot write %s (%s): the directory must be on an NTFS volume (a hard link is needed)" % (path, error.strerror or error.__class__.__name__))


def mark_downloaded(path: str):
	"""Windows: the Mark of the Web on a file that came from the web (its Zone.Identifier stream, Internet zone), so
	that Windows warns before it is opened or run, as for a file a browser saved. Best effort: a file system without
	such streams (FAT, a share) keeps the file unmarked."""
	try:
		with open(path + ":Zone.Identifier", "wb") as f:
			f.write(ZONE_IDENTIFIER)
	except OSError:
		pass


def remove_file(path: str, dir_fd=None):
	"""os.unlink. Windows: tried again a few times while the file is held (PermissionError); then what it raised."""
	for attempt in range(1, UNLINK_TRIES + 1):
		try:
			os.unlink(path, dir_fd=dir_fd)
			return
		except PermissionError:
			if not WINDOWS or attempt == UNLINK_TRIES:
				raise
			time.sleep(UNLINK_RETRY_S)


class NewFile:
	"""A file that is written next to where it will lie and put in place only when it is complete.

	Created with mode 0600, exclusively, no symlink followed. Without force an
	existing file is never replaced: the last step fails instead.
	"""

	def __init__(self, path, force):
		self.path = path
		self.force = force
		if os.path.isdir(path):
			raise CliError("%s is a directory" % path)
		if not force and os.path.lexists(path):
			raise CliError("%s exists; use --force to overwrite it" % path)
		directory = os.path.dirname(os.path.abspath(path))
		self.tmp = os.path.join(directory, ".bgw-export-%s.tmp" % secrets.token_hex(6))
		try:
			fd = os.open(self.tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | _O_NOFOLLOW | _O_BINARY, 0o600)
		except OSError as e:
			raise CliError("cannot write %s: %s" % (path, e.strerror or "error")) from None
		self.file = os.fdopen(fd, "wb")

	def write(self, data):
		try:
			self.file.write(data)
		except OSError as e:
			raise CliError("cannot write %s: %s" % (self.path, e.strerror or "error")) from None

	def abort(self):
		try:
			self.file.close()
		except OSError:
			pass
		try:
			os.unlink(self.tmp)
		except OSError:
			pass

	def commit(self):
		try:
			self.file.flush()
			os.fsync(self.file.fileno())
			self.file.close()
			if self.force:
				os.replace(self.tmp, self.path)
				if WINDOWS:
					mark_downloaded(self.path)
				return
			try:
				# A second name for the finished file: fails if that name is taken, and never replaces anything.
				os.link(self.tmp, self.path)
			except FileExistsError:
				raise CliError("%s exists; use --force to overwrite it" % self.path) from None
			except OSError as e:
				if WINDOWS:
					raise NoLink(self.path, e) from None
				raise
			if WINDOWS:
				mark_downloaded(self.path)
			try:
				remove_file(self.tmp)
			except OSError:
				if not WINDOWS:
					raise
				# Held for longer than the retries (a scanner): the file is in place, a second name of it stays behind.
		except OSError as e:
			raise CliError("cannot write %s: %s" % (self.path, e.strerror or "error")) from None
		finally:
			try:
				os.unlink(self.tmp)
			except OSError:
				pass


def export_file(args, daemon):
	"""bgw export for a retrieved file: its bytes, exactly, into a new file. Never printed.

	With -o: the path the caller names, as for a page. Without: the export directory, under a name made here.
	"""
	if args.output is None:
		if args.force:
			raise CliError("--force needs -o: in the export directory nothing is ever replaced")
		directory = download_dir()
		# In this order: is anything there, is there a token to ask it about, does it hold that token. Only then the directory.
		daemon.connect()
		daemon.prove("client", read_token("client"))
		dir_fd = open_download_dir(directory)
		try:
			final, info = save_download(dir_fd, lambda write, begin: download_file(daemon, args.page, write, begin), lambda known: export_name(args.page, known["type"]))
		except Refused as e:
			print("bgw: export refused: %s" % e, file=sys.stderr)
			return EXIT_TOOL_ERROR
		except NoRoom as e:
			raise CliError("the export directory %s is full: %s" % (directory, e)) from None
		except OSError as e:
			raise CliError("cannot write into %s: %s" % (directory, e.strerror or "error")) from None
		finally:
			close_download_dir(dir_fd)
		written = os.path.join(directory, final)
	else:
		target = NewFile(args.output, args.force)
		try:
			info = download_file(daemon, args.page, target.write)
			target.commit()
		except Refused as e:
			target.abort()
			print("bgw: export refused: %s" % e, file=sys.stderr)
			return EXIT_TOOL_ERROR
		except BaseException:
			target.abort()
			raise
		written = args.output
	# The name a server gave the file is no part of this: it is a server's word, and nothing here stands between markers.
	if args.json:
		dump({"file": args.page, "type": info["type"], "path": written, "bytes": info["size"], "sha256": info["sha256"], "untrusted": True})
	else:
		print("wrote %d bytes (%s, %s) to %s" % (info["size"], clean(args.page), info["type"], clean(written)))
		print(FILE_WARNING)
	return EXIT_OK


def cmd_export(args, daemon):
	"""Write the stored content of a page, or the bytes of a retrieved file, to a file, byte for byte. Never printed."""
	if args.output == "-" or args.output == "":
		raise CliError("-o needs a file name: the content is written to a file, never printed")
	if re.fullmatch(FILE_ID_RE, args.page):
		return export_file(args, daemon)
	if args.output is None:
		raise CliError("-o is needed for a page: the file to write its content to")
	# What comes back is page text as it was stored: no markers, nothing removed. The daemon hands that to the
	# operator only, so this asks with the operator's token - after the daemon proved that it holds it, as for
	# every request - and says so in plain words where that token is not to be had.
	try:
		read_token("admin")
	except CliError as e:
		if e.kind != "token":
			raise
		raise CliError("the content of a page is exported without its markers, so this needs the operator's token (admin.token) and is not for an agent: %s. An agent reads a page with bgw read; a retrieved file (fl_...) is exported with the agent token." % e, kind="token") from None
	body = {"page": args.page, "format": args.format}
	answer, _ = daemon.call("admin", "POST", "/v1/pages/export", body, QUICK_TIMEOUT_S, MAX_EXPORT_ANSWER_BYTES, refusals=(400, 404, 413))
	if answer.get("ok") is False:
		detail = answer.get("detail")
		print("bgw: export refused: %s" % clean(detail if isinstance(detail, str) else answer.get("error"), True).replace("\n", " | "), file=sys.stderr)
		return EXIT_TOOL_ERROR
	content = answer.get("content")
	if not isinstance(content, str) or answer.get("encoding") != "utf-8" or answer.get("page") != args.page or answer.get("format") != args.format:
		raise CliError("daemon did not return the content of that page")
	try:
		data = content.encode("utf-8")
	except UnicodeError:
		raise CliError("the content is not valid text") from None
	write_new_file(args.output, data, args.force)
	if args.json:
		dump({"page": args.page, "format": args.format, "path": args.output, "bytes": len(data)})
	else:
		print("wrote %d bytes (%s, %s) to %s" % (len(data), clean(args.page), args.format, clean(args.output)))
	return EXIT_OK


def as_object(value):
	"""value if it is a JSON object, else an empty one: what a printer may ask .get() of, whatever the daemon sent."""
	return value if isinstance(value, dict) else {}


def yes(value, no="no"):
	return "yes" if value is True else no


def version_mismatch(ext):
	"""One sentence when the daemon lately turned an extension of another protocol version away, else None.

	The daemon reports this to the operator only, and only while no extension is connected. The peer's version
	is what a peer claimed before it proved anything: it is printed as a small whole number or not at all.
	"""
	if not isinstance(ext, dict) or ext.get("connected") is not False:
		return None
	seen = ext.get("version_mismatch")
	if not isinstance(seen, dict):
		return None
	whole = lambda v: isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 999999
	own, peer = seen.get("daemon_protocol"), seen.get("peer_protocol")
	if not whole(own):
		return None
	theirs = "protocol version %d" % peer if whole(peer) else "another protocol version"
	return "an extension that speaks %s was turned away, this daemon speaks protocol version %d: update the daemon and the extension to the same release" % (theirs, own)


def cmd_status(args, daemon):
	status, _ = daemon.call("admin" if args.admin else "client", "GET", "/v1/status")
	if args.json:
		dump(status)
		return EXIT_OK
	print("daemon:    %s %s, up %s s" % (clean(status.get("name")), clean(status.get("version")), clean(status.get("uptime_s"))))
	print("paired:    %s" % yes(status.get("paired"), "no (run: bgw pair)"))
	print("extension: %s" % ("connected" if status.get("extension_connected") is True else "not connected"))
	ext = status.get("extension")
	if version_mismatch(ext):
		print("           %s" % version_mismatch(ext))
	if isinstance(ext, dict) and ext.get("connected"):
		browser = as_object(ext.get("browser"))
		print("           %s %s, extension %s" % (clean(browser.get("name", "?")), clean(browser.get("version", "?")), clean(ext.get("ext_version", "?"))))
		state = as_object(ext.get("state"))
		container = as_object(state.get("container")).get("ready")
		window = as_object(state.get("window")).get("open")
		print("           container %s, gateway window %s, %s slot(s)" % ("ready" if container else "NOT ready", "open" if window else "closed", clean(state.get("slots", "?"))))
		if state.get("pause_reason"):
			print("           pause reason: %s" % clean(state.get("pause_reason")))
		hosts = state.get("optin_hosts")
		if isinstance(hosts, list) and hosts:
			print("           logged-in session allowed on: %s" % ", ".join(clean(h) for h in hosts))
	print("paused:    %s" % yes(status.get("paused")))
	queue = as_object(status.get("queue"))
	print("queue:     %s waiting, %s running" % (clean(queue.get("queued", "?")), clean(queue.get("dispatched", "?"))))
	waiting = status.get("pending_operator_actions", "?")
	print("operator:  %s page(s) waiting for you%s" % (clean(waiting), " (bgw pending lists them)" if isinstance(waiting, int) and waiting > 0 else ""))
	print("opt-in:    %s rule host(s)" % clean(status.get("optin_rules", "?")))
	search = as_object(as_object(status.get("settings")).get("search"))
	if isinstance(search.get("engines"), list):
		print("search:    %s (default %s)" % (", ".join(clean(e) for e in search["engines"]), clean(search.get("default_engine", "?"))))
	store = as_object(status.get("store"))
	files = store.get("files")
	used, limit = store.get("file_bytes"), store.get("file_bytes_max")
	whole = lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 0
	size = " (%.1f of %d MiB)" % (used / 1048576, limit // 1048576) if whole(used) and whole(limit) else ""
	print("store:     %s page(s), %s with content%s" % (clean(store.get("pages", "?")), clean(store.get("stored", "?")), ", %d file(s)%s" % (files, size) if whole(files) and files > 0 else ""))
	if status.get("audit_ok") is False:
		print("audit:     FAILED - the daemon refuses work until the log can be written again (free disk space?)")
	if status.get("notifications") == "unavailable":
		print("notifications: not available on Windows")
	return EXIT_OK


def cmd_pair(args, daemon):
	nonce = b64url(secrets.token_bytes(32))
	answer, token = daemon.call("admin", "POST", "/v1/pair/start", {"nonce": nonce})
	code = answer.get("code")
	if not isinstance(code, str) or not re.fullmatch(r"bgw1\.[0-9]{1,5}\.[A-Za-z0-9_-]{43}", code):
		raise CliError("daemon did not return a pairing code")
	# A code the operator pastes into the browser decides who the extension
	# trusts. It is shown only if it verifiably comes from the daemon.
	if not same(answer.get("mac"), mac(token, "bgw1|pair|%d|%s|%s" % (daemon.port, nonce, code))):
		raise CliError("the pairing code did not come from the gateway daemon - not showing it")
	if args.json:
		seconds = answer.get("expires_in_s")
		dump({"code": code, "expires_in_s": seconds if isinstance(seconds, int) and not isinstance(seconds, bool) else None})
		return EXIT_OK
	try:
		minutes = int(answer.get("expires_in_s", 600)) // 60
	except (TypeError, ValueError, OverflowError):
		# Not a number of seconds (or none a finite one): the default the daemon uses.
		minutes = 10
	print(code)
	print("Paste this code into the Browser Gateway extension options within %d minutes; it works once." % minutes)
	return EXIT_OK


def pending_jobs(status):
	"""The pages that wait for the operator, out of an admin status answer."""
	jobs = status.get("pending")
	if not isinstance(jobs, list):
		raise CliError("daemon did not return the list of pending pages")
	return [j for j in jobs if isinstance(j, dict) and isinstance(j.get("job"), str)]


def cmd_pending(args, daemon):
	status, _ = daemon.call("admin", "GET", "/v1/status")
	jobs = pending_jobs(status)
	if args.json:
		dump(jobs)
		return EXIT_OK
	if not jobs:
		print("no page is waiting for you")
		return EXIT_OK
	for j in jobs:
		note = "opened" if j.get("acked") is True else "not opened yet"
		print("%s  %s  %s  waiting %s s, kept for another %s s, %s" % (clean(j.get("job")), clean(j.get("host", "?")), clean(j.get("kind", "?")), clean(j.get("waiting_s", "?")), clean(j.get("expires_in_s", "?")), note))
	print("Open one with: bgw open <job>")
	return EXIT_OK


def cmd_open(args, daemon):
	if not re.fullmatch(r"j_[0-9A-Za-z_-]{1,64}", args.job):
		raise CliError("not a job id: take one from bgw pending")
	answer, _ = daemon.call("admin", "POST", "/v1/attention", {"job": args.job})
	if args.json:
		dump({"sent": answer.get("sent") is True})
	if answer.get("sent") is not True:
		if not args.json:
			print("bgw: no such page is waiting (see bgw pending), or the browser is not connected", file=sys.stderr)
		return EXIT_TOOL_ERROR
	if not args.json:
		print("asked the browser to bring the page up in a window of its own")
	return EXIT_OK


def cmd_debug_job(args, daemon):
	job = {"kind": args.kind, "url": args.url, "session": args.session, "wait": {}, "extract": {}}
	if args.timeout_ms is not None:
		job["wait"]["timeout_ms"] = args.timeout_ms
	if args.html:
		job["extract"]["html"] = True
	answer, _ = daemon.call("admin", "POST", "/v1/jobs", job, JOB_TIMEOUT_S, MAX_JOB_ANSWER_BYTES)
